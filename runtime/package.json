{
  "name": "wp-bench-runtime",
  "version": "2.0.0",
  "private": true,
  "description": "WordPress runtime for WP-Bench grading",
  "scripts": {
    "start": "docker compose up -d --build --renew-anon-volumes --wait",
    "stop": "docker compose stop",
    "destroy": "docker compose down --volumes",
    "wp-bench": "docker compose exec -T grader wp eval-file /var/www/html/wp-content/plugins/wp-bench-runtime/verify-runtime.php"
  }
}
